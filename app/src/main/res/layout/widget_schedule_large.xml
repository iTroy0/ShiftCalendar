<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/grafik_sz_icon"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_large_employee"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#FAFAFC"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_large_today_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#FAFAFC"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_large_today_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#8FBFFF"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="9dp"
        android:background="#35405F" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_day_1_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#8FBFFF" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            <TextView android:id="@+id/widget_day_1_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="#FAFAFC" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_day_2_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#BFC8E6" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            <TextView android:id="@+id/widget_day_2_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="#FAFAFC" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_day_3_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#BFC8E6" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            <TextView android:id="@+id/widget_day_3_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="#FAFAFC" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_day_4_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#BFC8E6" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            <TextView android:id="@+id/widget_day_4_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="#FAFAFC" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_day_5_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#BFC8E6" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            <TextView android:id="@+id/widget_day_5_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="#FAFAFC" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_day_6_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#BFC8E6" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            <TextView android:id="@+id/widget_day_6_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="#FAFAFC" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/widget_day_7_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#BFC8E6" android:textSize="9sp" android:fontFamily="sans-serif-medium" android:maxLines="1"/>
            <TextView android:id="@+id/widget_day_7_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="#FAFAFC" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
