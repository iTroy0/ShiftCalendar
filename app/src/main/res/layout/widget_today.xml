<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_today_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сегодня"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <View
        android:id="@+id/widget_today_accent"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:background="#73798B" />

    <TextView
        android:id="@+id/widget_today_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="04:00–12:30"
        android:textColor="@color/widget_on_surface"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_today_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Почта и Verbox"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
